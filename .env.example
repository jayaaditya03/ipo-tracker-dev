# Copy this file to .env and fill in real values. Never commit .env.

DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-0123456789abcdef
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres — matches the database you created in psql
DATABASE_URL=postgres://ipo_user:devpassword@localhost:5432/ipo_tracker

# Fernet key for encrypting PAN numbers at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Angular dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200
